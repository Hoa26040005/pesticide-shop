rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Hàm kiểm tra người dùng đã xác thực
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Hàm kiểm tra quyền Quản trị viên (Admin)
    // Chỉ dựa vào trường role trong users/{uid} - không suy ra từ email
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // 3. Quản lý Đơn hàng (Orders)
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Quản lý Sản phẩm (Products)
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Quản lý Khách hàng & Sổ nợ (Customers & Debt)
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
      
      // Sổ biến động nợ: Bất biến - cấm sửa hoặc xóa lịch sử nợ
      match /debt_history/{historyId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // 6. Quản lý Lô hàng & Kho (Inventory Batches - FEFO)
    match /inventory_batches/{batchId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Nhật ký hệ thống (System Logs - Audit Trail)
    // Nghiêm cấm hoàn toàn hành vi chỉnh sửa hoặc xóa lịch sử kiểm toán
    match /system_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; 
    }

    // 8. Quản lý Tài khoản & Phân quyền (Users & Roles)
    // Phòng thủ chống leo thang quyền hạn (Privilege Escalation):
    // - Người dùng chỉ được sửa thông tin cá nhân của mình và TUYỆT ĐỐI không được tự ý sửa trường 'role'
    // - Chỉ tài khoản Admin mới có quyền cấp phát/thay đổi quyền 'role' hoặc xóa tài khoản
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Tự tạo hồ sơ chỉ được phép với quyền STAFF; Admin có thể tạo hồ sơ bất kỳ
      allow create: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         request.resource.data.role == 'STAFF');
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // 9. Cấu hình & Thông tin tài khoản Admin (Profiles & Settings)
    match /admin_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
