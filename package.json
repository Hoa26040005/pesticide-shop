{
  "name": "pesticide-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron.cjs",
  "description": "Ung dung quan ly cua hang thuoc BVTV",
  "author": "Ban",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && electron electron.cjs",
    "start:exe": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@vladmandic/face-api": "^1.7.15",
    "antd": "^6.1.0",
    "firebase": "^12.6.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "moment": "^2.30.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "react-to-print": "^3.2.0",
    "react-webcam": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.pesticideshop.app",
    "productName": "Quan Ly Thuoc BVTV",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/vite.svg"
    }
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
